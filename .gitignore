# ============================================
# MyDoc Repository .gitignore
# ============================================

# ===== Operating System Files =====
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ===== IDE & Editor Files =====
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Cursor (VSCode fork)
.cursor/

# JetBrains IDEs (IntelliJ, PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*.swp
*.swo

# ===== Python (for check_links.py and scripts) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
*.cover
.coverage
htmlcov/

# ===== Node.js (if adding any JS tooling) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ===== Build & Output Directories =====
dist/
build/
out/
*.log

# ===== Temporary & Cache Files =====
*.tmp
*.temp
*.cache
.cache/

# ===== Secrets & Credentials =====
.env
.env.local
.env.*.local
secrets.json
credentials.json
*.key
*.pem

# ===== Documentation Build (if using MkDocs/Docusaurus) =====
site/
docs/_build/
.docusaurus/

# ===== Personal Notes (not for repo) =====
PERSONAL_NOTES.md
TODO_PRIVATE.md
scratch/
drafts/

# ===== Backup Files =====
*.bak
*.backup
*~

# ===== Keep Important Files =====
# Force include certain files even if pattern matches
!.gitignore
!.github/
